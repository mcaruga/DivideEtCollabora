NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
FRONTEND_URL=https://your-app.railway.app

# Email - opzionale (lascia vuoto per disabilitare le notifiche email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Cloudinary - opzionale (lascia vuoto per usare storage locale)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
