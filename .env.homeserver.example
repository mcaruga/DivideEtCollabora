# Copy to `.env` on the server: `cp .env.homeserver.example .env`
# Then edit values below (at minimum POSTGRES_PASSWORD and JWT_SECRET).

# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=divideetcollabora
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=divideetcollabora

# ─── App ────────────────────────────────────────────────────
# Host port to expose the app on. Change if 3001 is taken.
APP_PORT=3001

# JWT signing secret. Generate with: openssl rand -hex 48
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# Public URL where users reach the app (used in emails / invite links).
# LAN only:      http://192.168.1.10:3001
# Local domain:  http://divide.home.lan
# Cloudflare:    https://divide.example.com
FRONTEND_URL=http://localhost:3001

# ─── Email (optional; leave blank to disable notifications) ─
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── Cloudinary (optional; falls back to local uploads/ volume) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
